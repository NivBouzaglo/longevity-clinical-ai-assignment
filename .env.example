# Copy to `.env` and adjust. Used by the FastAPI backend and the FastMCP server.
# (LibreChat has its OWN .env — see librechat/env.notes.md.)

# Shared bearer token for the MCP server. LibreChat's .env must set the SAME value
# so its Authorization: Bearer header is accepted. Change it for anything real.
MCP_BEARER_TOKEN=dev-longevity-token-change-me

# FastAPI backend base URL — the MCP server calls this.
BACKEND_URL=http://127.0.0.1:8001

# MLflow model server /invocations endpoint — the backend calls this.
MLFLOW_URL=http://127.0.0.1:5001/invocations

# MCP server bind. Must be 0.0.0.0 so LibreChat's Docker container can reach it
# via host.docker.internal.
MCP_HOST=0.0.0.0
MCP_PORT=9000

# Path to the mock patient DB. The backend already defaults to <repo>/data/patient_db.db,
# so you normally don't need to set this. Uncomment to override.
# PATIENT_DB_PATH=data/patient_db.db

# Your LibreChat OpenRouter key goes in LibreChat's own .env (as OPENROUTER_KEY),
# not here. The eval harness (evals/harness.py, run on the host, not in Docker)
# needs its OWN OpenRouter key below — it drives the model + MCP tools directly,
# independent of LibreChat. Get a free key at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
# Any OpenRouter model slug that supports function/tool calling.
# openai/gpt-oss-20b:free is a free-tier model with reliable tool calling —
# OpenRouter rate-limits free models by account history (~50 req/day with no
# purchased credits ever, ~1000/day once you've bought $10+ lifetime).
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Optional: a separate (e.g. cheaper) model for the LLM-as-judge behavioral
# checks (safety/no_fabrication). Defaults to OPENROUTER_MODEL if unset.
# OPENROUTER_JUDGE_MODEL=openai/gpt-oss-20b:free

# The MCP server the eval harness connects to. Defaults to the local server
# from `make mcp` — override only if you're pointing it at something else.
# MCP_URL=http://127.0.0.1:9000/mcp/
