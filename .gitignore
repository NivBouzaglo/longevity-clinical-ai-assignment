# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# uv / venv
.venv/

# Secrets / local env
.env
librechat/.env

# MLflow local artifacts (generated when serving/logging models locally)
mlruns/
mlartifacts/
mlflow.db

# Generated MLflow pyfunc router (rebuild with `uv run python models/generate_router.py`).
# Unlike data/patient_db.db and models/*.pkl (provided scaffold, committed on purpose),
# this is our build output: bundles cloned copies of the 5 pickles + a full env spec
# (uv.lock/pyproject.toml/conda.yaml) per save — reproducible from the script, not
# worth the repo bloat or drift risk of a checked-in binary.
models/mlflow_risk_router/

# evals/harness.py run artifacts (full per-case trace dumps) — not source,
# and contain a live model's raw output; regenerate with `make eval`.
evals/runs/

# Editors / OS
.DS_Store
.vscode/
.idea/

# Claude Code local (machine-specific, never shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock
